# Kopyalayın: cp .env.example .env  ve CHANGE_ME olanları doldurun.
# Güçlü değer üretmek için: openssl rand -base64 24

# Tarayıcıdan erişilen tam adres (CSRF koruması bununla çalışır)
APP_ORIGIN=https://kunye.alanadiniz.com

POSTGRES_USER=kunye
POSTGRES_DB=kunye
POSTGRES_PASSWORD=CHANGE_ME

# MinIO (yalnızca api kullanır, dış dünyaya kapalı)
MINIO_ROOT_USER=kunyeadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_EN_AZ_12_KARAKTER
S3_BUCKET=kunye-evrak
# Varsayılan imaj DONMUŞ resmi sürümdür (yama almaz). Bakımı süren S3 uyumlu bir imaja geçmek için:
# MINIO_IMAGE=...

# İlk açılışta hiç kullanıcı yoksa bu hesap oluşturulur (sonra ADMIN_PASSWORD satırını silin)
ADMIN_USERNAME=manav
ADMIN_PASSWORD=CHANGE_ME_EN_AZ_10_KARAKTER

# WEB_PORT=3000
# API_PORT=4000
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
# MAX_UPLOAD_MB=25
